#!/usr/bin/env python3
"""Small graphical front end for the platform-specific PikoPD installers."""

from __future__ import annotations

import os
import queue
import json
import re
import shutil
import subprocess
import sys
import threading
from pathlib import Path


ROOT = Path(__file__).resolve().parent
INSTALLERS = {
    "Linux (Ubuntu)": ROOT / "install-ubuntu.sh",
    "macOS": ROOT / "install-mac.sh",
}
PIKO_HOME = Path(os.environ.get("PIKO_HOME") or Path.home() / "piko-workspace").expanduser().resolve()
PIKOPD_DIR = PIKO_HOME / "pikoPD"
PIKOPD_LAUNCHER = PIKO_HOME / "piko-run"
# Keep existing installations usable when their legacy launcher is a file.
# On case-insensitive macOS, "pikopd" is the pikoPD repository directory.
if not PIKOPD_LAUNCHER.is_file() and (PIKO_HOME / "pikopd").is_file():
    PIKOPD_LAUNCHER = PIKO_HOME / "pikopd"
DEMO_PATCH = "patches/heavy.pd"
DEMO_PROJECT = "piko_setup_heavy"
PREFERENCES_FILE = Path.home() / ".config" / "pikosetup" / "preferences.json"
ANSI_ESCAPE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|\x1b\\))")
os.environ["PATH"] = f"/opt/homebrew/bin:/usr/local/bin:{os.environ.get('PATH', '')}"


def load_preferences() -> dict[str, str]:
    try:
        value = json.loads(PREFERENCES_FILE.read_text(encoding="utf-8"))
        if isinstance(value, dict):
            return value
    except (OSError, json.JSONDecodeError):
        pass
    return {}


def save_preferences(patch_path: str, board_path: str, platform: str) -> None:
    PREFERENCES_FILE.parent.mkdir(parents=True, exist_ok=True)
    PREFERENCES_FILE.write_text(
        json.dumps({"patch": patch_path, "board": board_path, "platform": platform}, indent=2) + "\n",
        encoding="utf-8",
    )


def installation_is_ready() -> bool:
    required_files = (
        PIKOPD_DIR / "pikopd.py",
        PIKOPD_DIR / DEMO_PATCH,
        PIKOPD_DIR / "board.json",
        PIKO_HOME / "pico-sdk" / "external" / "pico_sdk_import.cmake",
        PIKO_HOME / "venv" / "bin" / "hvcc",
        PIKOPD_LAUNCHER,
    )
    required_commands = ("cmake", "ninja", "arm-none-eabi-gcc", "picotool")
    return all(path.is_file() for path in required_files) and all(
        shutil.which(command) for command in required_commands
    )


def ensure_tkinter() -> None:
    if sys.platform == "darwin":
        # The Apple Python ships obsolete Tk 8.5. Select a modern runtime
        # before constructing any window, even when that old import succeeds.
        probe = "import tkinter, sys; sys.exit(tkinter.TkVersion < 8.6)"
        candidates = [
            "/opt/homebrew/opt/python@3.13/bin/python3.13",
            "/usr/local/opt/python@3.13/bin/python3.13",
            sys.executable,
        ]
        for candidate in candidates:
            if not Path(candidate).is_file():
                continue
            try:
                result = subprocess.run(
                    [candidate, "-c", probe], stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, timeout=10,
                )
            except (OSError, subprocess.TimeoutExpired):
                continue
            if result.returncode == 0:
                if Path(candidate).resolve() != Path(sys.executable).resolve():
                    os.execv(candidate, [candidate, str(Path(__file__).resolve()), *sys.argv[1:]])
                return
        bootstrap = ROOT / "piko-setup-mac.command"
        if not bootstrap.is_file():
            raise RuntimeError(f"Missing macOS launcher: {bootstrap}. Keep the project files together.")
        os.execv("/bin/bash", ["/bin/bash", str(bootstrap), *sys.argv[1:]])

    try:
        import tkinter  # noqa: F401
        return
    except ImportError:
        pass

    pkexec = shutil.which("pkexec")
    if not pkexec:
        raise RuntimeError(
            "Python Tk is not installed and pkexec was not found.\n"
            "Install it with: sudo apt install python3-tk"
        )

    result = subprocess.run([pkexec, "apt-get", "install", "-y", "python3-tk"])
    if result.returncode != 0:
        raise RuntimeError("Could not install python3-tk to open the window.")

    os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]])


def main() -> int:
    try:
        ensure_tkinter()
    except RuntimeError as error:
        print(error, file=sys.stderr)
        return 1

    import tkinter as tk
    from tkinter import filedialog, messagebox, ttk

    is_mac = sys.platform == "darwin"
    available_platform = "macOS" if sys.platform == "darwin" else "Linux (Ubuntu)"

    root = tk.Tk()
    root.title("PikoPD Setup")
    screen_width = root.winfo_screenwidth()
    screen_height = root.winfo_screenheight()
    window_width = min(820, max(600, screen_width - 40))
    window_height = min(700, max(540, screen_height - 80))
    root.geometry(f"{window_width}x{window_height}")
    root.minsize(min(600, window_width), min(520, window_height))
    already_installed = installation_is_ready()
    preferences = load_preferences()
    selected_platform = tk.StringVar(
        value=preferences.get("platform", available_platform)
    )
    if selected_platform.get() not in INSTALLERS:
        selected_platform.set(available_platform)
    selected_patch = tk.StringVar(
        value=preferences.get("patch", str(ROOT / "test.pd"))
    )
    selected_board = tk.StringVar(
        value=preferences.get("board", str(ROOT / "board.json"))
    )

    colors = {
        "background": "#17191f",
        "surface": "#22252d",
        "input": "#101217",
        "text": "#edf0f5",
        "muted": "#b2b8c4",
        "accent": "#6c8cff",
        "accent_active": "#829dff",
        "disabled": "#565d6b",
    }
    if is_mac:
        colors.update({
            "background": "#181c24", "surface": "#293241",
            "input": "#10141c", "text": "#e8edf5",
            "muted": "#aebbd0", "accent": "#245ac4",
            "accent_active": "#306bdc", "disabled": "#75839a",
        })
    style = ttk.Style(root)
    available_themes = style.theme_names()
    for theme_name in ("clam", "classic"):
        if theme_name in available_themes:
            style.theme_use(theme_name)
            break
    root.configure(background=colors["background"])
    style.configure("TFrame", background=colors["background"])
    style.configure("TLabel", background=colors["background"], foreground=colors["text"])
    style.configure(
        "TCombobox",
        fieldbackground=colors["input"],
        background=colors["surface"],
        foreground=colors["text"],
        arrowcolor=colors["text"],
        selectbackground=colors["accent"],
        selectforeground="#ffffff",
    )
    style.map(
        "TCombobox",
        fieldbackground=[("readonly", colors["input"])],
        foreground=[("readonly", colors["text"])],
        selectbackground=[("readonly", colors["input"])],
        selectforeground=[("readonly", colors["text"])],
    )
    style.configure(
        "Title.TLabel",
        background=colors["background"],
        foreground=colors["text"],
        font=("TkDefaultFont", 16, "bold"),
    )
    style.configure(
        "Vertical.TScrollbar",
        background=colors["surface"],
        troughcolor=colors["input"],
        bordercolor=colors["input"],
        arrowcolor=colors["text"],
    )
    # Tk renders the readonly combobox menu as a separate classic Listbox.
    # Give it the same high contrast as the rest of the dark interface.
    root.option_add("*TCombobox*Listbox.background", colors["input"])
    root.option_add("*TCombobox*Listbox.foreground", colors["text"])
    root.option_add("*TCombobox*Listbox.selectBackground", colors["accent"])
    root.option_add("*TCombobox*Listbox.selectForeground", "#ffffff")

    if is_mac:
        # Clam draws button backgrounds reliably on macOS, unlike tk.Button.
        style.configure(
            "TButton", background=colors["surface"], foreground=colors["text"],
            bordercolor=colors["surface"], lightcolor=colors["surface"],
            darkcolor=colors["surface"], padding=(16, 10),
            font=("TkDefaultFont", 11), focuscolor=colors["accent_active"],
        )
        style.map(
            "TButton",
            background=[("disabled", colors["surface"]), ("pressed", colors["input"]),
                        ("active", "#35445b")],
            foreground=[("disabled", colors["disabled"]), ("!disabled", colors["text"])],
        )
        style.configure(
            "Accent.TButton", background=colors["accent"], foreground="#ffffff",
            bordercolor=colors["accent"], font=("TkDefaultFont", 11, "bold"),
        )
        style.map(
            "Accent.TButton",
            background=[("disabled", colors["surface"]), ("pressed", "#1d49a0"),
                        ("active", colors["accent_active"])],
            foreground=[("disabled", colors["disabled"]), ("!disabled", "#ffffff")],
        )

    def make_button(parent: object, **options: object) -> object:
        if not is_mac:
            return tk.Button(parent, **options)
        button_options = {key: value for key, value in options.items()
                          if key in {"text", "command", "width", "state"}}
        button_options["style"] = (
            "Accent.TButton" if options.get("background") == colors["accent"] else "TButton"
        )
        return ttk.Button(parent, **button_options)

    outer = ttk.Frame(root, padding=16)
    outer.grid(row=0, column=0, sticky="nsew")
    root.columnconfigure(0, weight=1)
    root.rowconfigure(0, weight=1)
    outer.columnconfigure(0, weight=1)
    outer.rowconfigure(4, weight=1)
    path_wraplength = max(240, min(500, screen_width - 360))

    ttk.Label(outer, text="PikoPD Installer", style="Title.TLabel").grid(
        row=0, column=0, sticky="w"
    )
    ttk.Label(
        outer,
        text="Install the toolchain and prepare the environment to build Pure Data patches for Raspberry Pi Pico.",
        wraplength=700,
    ).grid(row=1, column=0, sticky="w", pady=(6, 14))

    platform_frame = ttk.Frame(outer)
    platform_frame.grid(row=2, column=0, sticky="w", pady=(0, 8))
    ttk.Label(platform_frame, text="Operating system").pack(side="left", padx=(0, 10))
    platform_picker = ttk.Combobox(
        platform_frame,
        textvariable=selected_platform,
        values=tuple(INSTALLERS),
        state="readonly",
        width=18,
    )
    platform_picker.pack(side="left")

    def save_platform_preference(_event: object = None) -> None:
        save_preferences(selected_patch.get(), selected_board.get(), selected_platform.get())

    platform_picker.bind("<<ComboboxSelected>>", save_platform_preference)

    selection_frame = ttk.Frame(outer)
    selection_frame.grid(row=3, column=0, sticky="ew", pady=(0, 12))
    selection_frame.columnconfigure(1, weight=1)

    def browse_patch() -> None:
        current = Path(selected_patch.get()).expanduser()
        initial_dir = current.parent if current.parent.is_dir() else PIKOPD_DIR
        if not initial_dir.is_dir():
            initial_dir = Path.home()
        path = filedialog.askopenfilename(
            title="Select a Pure Data patch",
            initialdir=str(initial_dir),
            filetypes=[("Pure Data patches", "*.pd"), ("All files", "*.*")],
        )
        if path:
            selected_patch.set(str(Path(path).resolve()))
            save_preferences(selected_patch.get(), selected_board.get(), selected_platform.get())

    def browse_board() -> None:
        current = Path(selected_board.get()).expanduser()
        initial_dir = current.parent if current.parent.is_dir() else PIKOPD_DIR
        if not initial_dir.is_dir():
            initial_dir = Path.home()
        path = filedialog.askopenfilename(
            title="Select a board configuration",
            initialdir=str(initial_dir),
            filetypes=[("JSON configuration", "*.json"), ("All files", "*.*")],
        )
        if path:
            selected_board.set(str(Path(path).resolve()))
            save_preferences(selected_patch.get(), selected_board.get(), selected_platform.get())

    ttk.Label(selection_frame, text="Pure Data patch (.pd)").grid(
        row=0, column=0, sticky="w", padx=(0, 12), pady=5
    )
    ttk.Label(
        selection_frame, textvariable=selected_patch, wraplength=path_wraplength
    ).grid(row=0, column=1, sticky="w", pady=5)
    make_button(
        selection_frame,
        text="Browse…",
        command=browse_patch,
        background=colors["surface"],
        foreground=colors["text"],
        activebackground=colors["accent_active"],
        activeforeground="#ffffff",
        relief="flat",
        borderwidth=0,
        padx=12,
        pady=6,
        cursor="hand2",
    ).grid(row=0, column=2, padx=(12, 0), pady=3)

    ttk.Label(selection_frame, text="Board configuration (.json)").grid(
        row=1, column=0, sticky="w", padx=(0, 12), pady=5
    )
    ttk.Label(
        selection_frame, textvariable=selected_board, wraplength=path_wraplength
    ).grid(row=1, column=1, sticky="w", pady=5)
    make_button(
        selection_frame,
        text="Browse…",
        command=browse_board,
        background=colors["surface"],
        foreground=colors["text"],
        activebackground=colors["accent_active"],
        activeforeground="#ffffff",
        relief="flat",
        borderwidth=0,
        padx=12,
        pady=6,
        cursor="hand2",
    ).grid(row=1, column=2, padx=(12, 0), pady=3)

    log_frame = ttk.Frame(outer)
    log_frame.grid(row=4, column=0, sticky="nsew")
    output = tk.Text(
        log_frame,
        wrap="word",
        state="disabled",
        font=("Menlo", 11) if is_mac else ("monospace", 9),
        height=14,
        background=colors["input"],
        foreground=colors["text"],
        insertbackground=colors["text"],
        selectbackground=colors["accent"],
        selectforeground="#ffffff",
        relief="flat",
        padx=10,
        pady=10,
    )
    scrollbar = ttk.Scrollbar(log_frame, orient="vertical", command=output.yview)
    output.configure(yscrollcommand=scrollbar.set)
    output.pack(side="left", fill="both", expand=True)
    scrollbar.pack(side="right", fill="y")

    status = tk.StringVar(
        value=(
            "Installation detected. Select your files, connect the Pico in BOOTSEL mode, then click Run / Flash."
            if already_installed
            else "Ready to install. You can choose your patch and board configuration now."
        )
    )
    ttk.Label(outer, textvariable=status, wraplength=700).grid(
        row=5, column=0, sticky="w", pady=(12, 8)
    )
    button_row = ttk.Frame(outer)
    button_row.grid(row=6, column=0, sticky="ew", pady=(4, 18))
    button_row.columnconfigure(0, weight=1)
    install_button = make_button(
        button_row,
        text="Run / Flash" if already_installed else "Install",
        width=16,
        height=2,
        padx=18,
        pady=10,
        background=colors["accent"],
        foreground="#ffffff",
        activebackground=colors["accent_active"],
        activeforeground="#ffffff",
        disabledforeground=colors["muted"],
        relief="flat",
        borderwidth=0,
        highlightthickness=0,
        font=("TkDefaultFont", 10, "bold"),
        cursor="hand2",
    )
    install_button.grid(row=0, column=0, sticky="e", padx=4, pady=2)

    messages: queue.Queue[tuple[str, object]] = queue.Queue()
    process: subprocess.Popen[bytes] | None = None

    def append_output(chunk: str) -> None:
        clean = ANSI_ESCAPE.sub("", chunk).replace("\r", "\n")
        output.configure(state="normal")
        output.insert("end", clean)
        output.see("end")
        output.configure(state="disabled")

    def run_command(action: str, command: list[str], cwd: Path, gui_admin: bool = False) -> None:
        nonlocal process
        environment = os.environ.copy()
        environment["PYTHONUNBUFFERED"] = "1"
        if gui_admin:
            environment["PIKOPD_GUI"] = "1"
        try:
            process = subprocess.Popen(
                command,
                cwd=cwd,
                env=environment,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                bufsize=0,
            )
            assert process.stdout is not None
            while True:
                chunk = os.read(process.stdout.fileno(), 4096)
                if not chunk:
                    break
                messages.put(("output", chunk.decode("utf-8", errors="replace")))
            messages.put(("finished", (action, process.wait())))
        except Exception as error:  # Report launch errors in the window.
            messages.put(("launch_error", (action, str(error))))

    def start_install() -> None:
        installer = INSTALLERS[selected_platform.get()]
        if not installer.is_file():
            messagebox.showerror("PikoSetup", f"Installer not found:\n{installer}")
            install_button.configure(state="normal")
            return
        install_button.configure(state="disabled")
        status.set("Installing…")
        append_output("Starting installer…\n\n")
        threading.Thread(
            target=run_command,
            args=("install", [str(installer)], ROOT, selected_platform.get() == "Linux (Ubuntu)"),
            daemon=True,
        ).start()

    def start_flash() -> None:
        patch_path = Path(selected_patch.get()).expanduser()
        board_path = Path(selected_board.get()).expanduser()
        if not patch_path.is_file():
            messagebox.showerror("PikoPD Setup", f"Patch file not found:\n{patch_path}")
            return
        if not board_path.is_file():
            messagebox.showerror("PikoPD Setup", f"Board configuration not found:\n{board_path}")
            return
        if not PIKOPD_LAUNCHER.is_file():
            messagebox.showerror(
                "PikoPD Setup",
                f"PikoPD launcher not found:\n{PIKOPD_LAUNCHER}",
            )
            return
        if not messagebox.askyesno(
            "Flash firmware to Pico",
            "Connect the Raspberry Pi Pico in BOOTSEL mode.\n\n"
            f"This will compile {patch_path.name} using {board_path.name} and flash the device.\n"
            "Continue?",
        ):
            return
        install_button.configure(state="disabled")
        status.set(f"Building {patch_path.name} and flashing the Pico…")
        append_output(f"\nBuilding and flashing {patch_path}…\n\n")
        command = [
            str(PIKOPD_LAUNCHER),
            str(patch_path.resolve()),
            DEMO_PROJECT,
            "-b",
            str(board_path.resolve()),
            "-f",
        ]
        threading.Thread(
            target=run_command,
            args=("flash", command, PIKOPD_DIR),
            daemon=True,
        ).start()

    def poll_messages() -> None:
        while True:
            try:
                kind, value = messages.get_nowait()
            except queue.Empty:
                break
            if kind == "output":
                append_output(str(value))
            elif kind == "finished":
                action, return_code = value
                code = int(return_code)
                install_button.configure(state="normal")
                if action == "install" and code == 0:
                    status.set("Installation complete. Select your files, then use Run / Flash.")
                    append_output("\nInstallation completed successfully.\n")
                    install_button.configure(text="Run / Flash", command=start_flash)
                    messagebox.showinfo(
                        "PikoPD Setup",
                        "Installation complete. Select a patch and board configuration, connect the Pico in BOOTSEL mode, then click Run / Flash.",
                    )
                elif action == "flash" and code == 0:
                    status.set(f"{Path(selected_patch.get()).name} was built and flashed to the Pico.")
                    append_output("\nFirmware built and flashed successfully.\n")
                    messagebox.showinfo("PikoPD Setup", "Firmware built and flashed successfully.")
                else:
                    operation = "installation" if action == "install" else "Run / Flash"
                    status.set(f"The {operation} operation failed (exit code {code}).")
                    append_output(f"\nOperation finished with exit code {code}.\n")
                    messagebox.showerror(
                        "PikoPD Setup",
                        "The operation failed. Check the output above for details.",
                    )
            elif kind == "launch_error":
                action, error = value
                install_button.configure(state="normal")
                status.set("Could not start the operation.")
                append_output(f"\nCould not start: {error}\n")
        root.after(100, poll_messages)

    if already_installed:
        install_button.configure(command=start_flash)
    else:
        install_button.configure(command=start_install)
    root.after(100, poll_messages)
    root.mainloop()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
